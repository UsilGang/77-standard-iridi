{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iridi.example/schema/editorial-job.schema.json",
  "title": "Editorial assignment",
  "type": "object",
  "required": [
    "schema_version", "editorial_job_uid", "status", "created_at", "initiator", "source_refs",
    "reader_problem", "audiences", "disposition", "base_release", "targets", "operations",
    "content_plan", "visual_required", "expected_outputs", "acceptance_criteria", "reviewers",
    "change_class", "normative_impact", "compatibility_impact", "proposed_release_bump"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "editorial_job_uid": {"type": "string", "pattern": "^EDT-[0-9]{4}-[0-9]{4}$"},
    "status": {"enum": ["candidate", "draft", "needs_evidence", "review", "approved", "rejected", "out_of_scope", "no_change", "in_progress", "validation", "release_ready", "released", "archived"]},
    "created_at": {"type": "string"},
    "initiator": {"type": "object"},
    "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "reader_problem": {"type": "string", "minLength": 1},
    "audiences": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "disposition": {"enum": ["already_documented", "editorial_gap", "product_gap", "out_of_scope", "conflict", "needs_evidence", "noise"]},
    "base_release": {"type": "string"},
    "template_candidate_uid": {"type": "string"},
    "template_uid": {"type": "string"},
    "section_template_uid": {"type": "string"},
    "decision_ref": {"type": ["string", "null"]},
    "targets": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "operations": {"type": "object"},
    "content_plan": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "legacy_quality_findings": {"type": "array", "items": {"type": "object"}},
    "visual_required": {"type": "boolean"},
    "visual_plan": {"type": "object"},
    "expected_outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "reviewers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "change_class": {"type": "string"},
    "normative_impact": {"type": "string"},
    "compatibility_impact": {"type": "string"},
    "proposed_release_bump": {"type": "string"},
    "external_write": {"type": "boolean"},
    "publication_allowed": {"type": "boolean"},
    "d8_status": {"type": "string"}
  },
  "additionalProperties": false
}
